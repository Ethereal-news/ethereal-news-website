---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime } from "@lib/utils";
import { HOME } from "@consts";
import UpcomingCalendar from "@components/UpcomingCalendar.astro";
import Link from "@components/Link.astro";
import SubscribeButton from "@components/SubscribeButton.astro";
import OpenInAI from "@components/OpenInAI.astro";
import { getCollection, render } from "astro:content";

const issues = (await getCollection("issues"))
  .filter((issue) => !issue.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

const issue = issues[0];

const { Content } = await render(issue);
---

<Layout
  title={HOME.TITLE}
  description={issue.data.description}
  publishedDate={issue.data.date}
  isArticle={true}
>
  <Container>
    <div data-pagefind-ignore>
      <div class="space-y-10">
        <div class="space-y-1">
          <h1 class="animate text-3xl font-semibold text-black dark:text-white">
            <a
              href={`/${issue.id.replace(/\/index$/, "")}/`}
            >
              {issue.data.title}
            </a>
          </h1>
          <div class="animate flex items-center gap-1.5 text-xs uppercase tracking-wide text-black/60 dark:text-white/60">
            <div>
              <FormattedDate date={issue.data.date} />
            </div>
            &bull;
            {issue.body && (
              <div>
                {readingTime(issue.body)}
              </div>
            )}
            &bull;
            <OpenInAI issueId={issue.id.replace(/\/index$/, "")} title={issue.data.title} />
          </div>
        </div>
        <SubscribeButton />
        <article>
          <Content />
        </article>

        <div class="animate flex flex-wrap items-center justify-between gap-y-2">
          <Link href="/archive/"> See all issues </Link>
        </div>

        <UpcomingCalendar />
      </div>
    </div>
  </Container>
</Layout>
