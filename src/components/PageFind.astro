---
import Search from "astro-pagefind/components/Search.astro";
---

<aside data-pagefind-ignore>
  <div
    transition:persist
    id="backdrop"
    class="hidden fixed left-0 top-0 z-50 h-screen w-full items-start justify-center bg-black/50 p-6 backdrop-blur-xs"
  >
    <div id="pagefind-container" class="w-full max-w-(--breakpoint-sm)">
      <Search
        searchboxOptions={{
          placeholder: "Search Ethereal news…",
          "hide-shortcut": true,
          "show-sub-results": true,
        }}
      />
    </div>
  </div>
</aside>

<script is:inline>
  function setupPagefind() {
    const magnifyingGlass = document.getElementById("magnifying-glass");
    const backdrop = document.getElementById("backdrop");

    function getSearchbox() {
      return document.querySelector("#pagefind-container pagefind-searchbox");
    }

    function openPagefind() {
      // show first (can't focus a display:none element), then focus
      backdrop?.classList.remove("hidden");
      backdrop?.classList.add("flex");
      const searchbox = getSearchbox();
      // pagefind-searchbox exposes a public focus() that focuses its input
      setTimeout(() => {
        if (searchbox && typeof searchbox.focus === "function") {
          searchbox.focus();
        } else {
          searchbox?.querySelector("input")?.focus();
        }
      }, 0);
    }

    function closePagefind() {
      const input = getSearchbox()?.querySelector("input");
      if (input) {
        input.value = "";
        // notify the component so it clears its results
        input.dispatchEvent(new Event("input", { bubbles: true }));
      }
      backdrop?.classList.remove("flex");
      backdrop?.classList.add("hidden");
    }

    // open pagefind
    magnifyingGlass?.addEventListener("click", () => {
      openPagefind();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "/") {
        e.preventDefault();
        openPagefind();
      } else if ((e.metaKey || e.ctrlKey) && e.key === "k") {
        e.preventDefault();
        openPagefind();
      }
    });

    // close pagefind
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        closePagefind();
      }
    });

    // close pagefind when a search result link is clicked
    document.addEventListener("click", (event) => {
      const link = event.target.closest?.("a");
      if (link && link.closest("pagefind-searchbox")) {
        closePagefind();
      }
    });

    backdrop?.addEventListener("click", (event) => {
      if (!event.target.closest("#pagefind-container")) {
        closePagefind();
      }
    });
  }

  setupPagefind();
  document.addEventListener("astro:after-swap", setupPagefind);
</script>

<style is:global>
  :root {
    --pf-font: "Geist", sans-serif;
    --pf-border-radius: 3px;
    --pf-input-font-size: 0.9rem;
    --pf-result-title-font-size: 0.9rem;
    --pf-result-excerpt-font-size: 0.8rem;
    --pf-summary-font-size: 0.8rem;
    --pf-searchbox-max-width: 100%;

    --pf-background: #ffffff;
    --pf-text: #3d3d3d;
    --pf-text-secondary: #525252;
    --pf-text-muted: #737373;
    --pf-border: #d0d0d0;
    --pf-border-focus: #a3a3a3;
    --pf-hover: #f5f5f5;
    --pf-mark: #fde68a;
  }

  .dark {
    --pf-background: #171717;
    --pf-text: #d4d4d4;
    --pf-text-secondary: #a3a3a3;
    --pf-text-muted: #737373;
    --pf-border: #404040;
    --pf-border-focus: #525252;
    --pf-hover: #262626;
    --pf-mark: #78350f;
  }

  #pagefind-container .pf-searchbox-result-title {
    font-weight: 600;
  }
</style>
