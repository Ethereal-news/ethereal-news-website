---
import Search from "astro-pagefind/components/Search.astro";
---

<aside data-pagefind-ignore>
  <div
    transition:persist
    id="backdrop"
    class="bg-[rgba(0, 0, 0, 0.5] invisible fixed left-0 top-0 z-50 flex h-screen w-full justify-center p-6 backdrop-blur-xs"
  >
    <div
      id="pagefind-container"
      class="m-0 flex h-fit max-h-[80%] w-full max-w-(--breakpoint-sm) flex-col overflow-auto rounded-sm border border-black/15 bg-neutral-100 p-2 px-4 py-3 shadow-lg dark:border-white/20 dark:bg-neutral-900"
    >
      <Search
        searchboxOptions={{
          placeholder: "Search Ethereal news…",
          "hide-shortcut": true,
          "show-sub-results": true,
        }}
      />
      <div class="mr-2 pb-1 pt-4 text-right text-xs dark:prose-invert">
        Press <span class="prose text-xs dark:prose-invert"
          ><kbd class="">Esc</kbd></span
        > or click anywhere to close
      </div>
    </div>
  </div>
</aside>

<script is:inline>
  function setupPagefind() {
    const magnifyingGlass = document.getElementById("magnifying-glass");
    const backdrop = document.getElementById("backdrop");

    function getSearchbox() {
      return document.querySelector("#pagefind-container pagefind-searchbox");
    }

    function openPagefind() {
      const searchbox = getSearchbox();
      // pagefind-searchbox exposes a public focus() that focuses its input
      setTimeout(() => {
        if (searchbox && typeof searchbox.focus === "function") {
          searchbox.focus();
        } else {
          searchbox?.querySelector("input")?.focus();
        }
      }, 0);
      backdrop?.classList.remove("invisible");
      backdrop?.classList.add("visible");
    }

    function closePagefind() {
      const input = getSearchbox()?.querySelector("input");
      if (input) {
        input.value = "";
        // notify the component so it clears its results
        input.dispatchEvent(new Event("input", { bubbles: true }));
      }
      backdrop?.classList.remove("visible");
      backdrop?.classList.add("invisible");
    }

    // open pagefind
    magnifyingGlass?.addEventListener("click", () => {
      openPagefind();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "/") {
        e.preventDefault();
        openPagefind();
      } else if ((e.metaKey || e.ctrlKey) && e.key === "k") {
        e.preventDefault();
        openPagefind();
      }
    });

    // close pagefind
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        closePagefind();
      }
    });

    // close pagefind when a search result link is clicked
    document.addEventListener("click", (event) => {
      const link = event.target.closest?.("a");
      if (link && link.closest("pagefind-searchbox")) {
        closePagefind();
      }
    });

    backdrop?.addEventListener("click", (event) => {
      if (!event.target.closest("#pagefind-container")) {
        closePagefind();
      }
    });
  }

  setupPagefind();
  document.addEventListener("astro:after-swap", setupPagefind);
</script>

<style is:global>
  :root {
    --pf-font: "Geist", sans-serif;
    --pf-border-radius: 3px;
    --pf-input-font-size: 0.9rem;
    --pf-result-title-font-size: 0.9rem;
    --pf-result-excerpt-font-size: 0.8rem;
    --pf-summary-font-size: 0.8rem;
    --pf-searchbox-max-width: 100%;

    --pf-background: #ffffff;
    --pf-text: #3d3d3d;
    --pf-text-secondary: #525252;
    --pf-text-muted: #737373;
    --pf-border: #d0d0d0;
    --pf-border-focus: #a3a3a3;
    --pf-hover: #f5f5f5;
    --pf-mark: #fde68a;
  }

  .dark {
    --pf-background: #171717;
    --pf-text: #d4d4d4;
    --pf-text-secondary: #a3a3a3;
    --pf-text-muted: #737373;
    --pf-border: #404040;
    --pf-border-focus: #525252;
    --pf-hover: #262626;
    --pf-mark: #78350f;
  }

  /* let the searchbox flow inside the modal container rather than as an
     absolutely-positioned dropdown overlay */
  #pagefind-container .pf-searchbox-dropdown {
    position: static;
    box-shadow: none;
    border: none;
  }

  #pagefind-container .pf-searchbox-result-title {
    font-weight: 600;
  }
</style>
