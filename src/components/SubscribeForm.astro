---
import { SUBSCRIBE } from "@consts";

// Substack's official embed. Substack doesn't add signups posted from other
// sites, so the form has to live in Substack's own iframe, which handles
// validation and confirmation. Substack sets the look (white card, orange
// button) and has no dark mode.
---

<div class="not-prose flex flex-col items-center gap-2" data-pagefind-ignore>
  <iframe
    src={SUBSCRIBE.EMBED_URL}
    title="Subscribe to Ethereal news"
    loading="lazy"
    width="480"
    height="320"
    class="h-[340px] w-full max-w-[480px] rounded-sm border border-solid border-black/15 bg-white dark:border-white/20"
    scrolling="no"></iframe>
  <p class="text-xs text-black/50 dark:text-white/50">
    Prefer a feed reader? <a
      href="/rss.xml"
      class="underline decoration-black/30 underline-offset-2 hover:text-black dark:decoration-white/30 dark:hover:text-white"
      >RSS</a
    >
  </p>
</div>
