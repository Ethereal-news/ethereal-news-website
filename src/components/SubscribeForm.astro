---
import { SUBSCRIBE } from "@consts";

type Props = {
  /** Heading above the form. */
  heading?: string;
};

const { heading = "Get Ethereal news in your inbox" } = Astro.props;
---

<form
  action={SUBSCRIBE.FORM_ACTION}
  method="post"
  target="_blank"
  class="not-prose rounded-sm border border-black/15 p-4 dark:border-white/20"
  data-pagefind-ignore
>
  <div class="font-semibold text-black dark:text-white">{heading}</div>
  <p class="mt-1 text-sm text-black/60 dark:text-white/60">
    Curated Ethereum news focused on developers, every week. Free.
  </p>
  <div class="mt-3 flex flex-col gap-2 sm:flex-row">
    <input
      type="email"
      name="email"
      required
      autocomplete="email"
      placeholder="you@example.com"
      aria-label="Email address"
      class="min-h-11 w-full rounded-sm border border-black/15 bg-white px-3 text-sm text-black placeholder:text-black/40 focus:border-black/40 focus:outline-none dark:border-white/20 dark:bg-neutral-950 dark:text-white dark:placeholder:text-white/40 dark:focus:border-white/50"
    />
    <button
      type="submit"
      class="min-h-11 shrink-0 cursor-pointer rounded-sm bg-neutral-800 px-5 text-sm font-semibold text-white transition-colors duration-300 ease-in-out hover:bg-neutral-900 focus-visible:bg-neutral-900 dark:bg-neutral-200 dark:text-black dark:hover:bg-neutral-100 dark:focus-visible:bg-neutral-100"
    >
      Subscribe
    </button>
  </div>
  <p class="mt-2 text-xs text-black/50 dark:text-white/50">
    Delivered via Substack. Prefer a feed reader? <a
      href="/rss.xml"
      class="underline decoration-black/30 underline-offset-2 hover:text-black dark:decoration-white/30 dark:hover:text-white"
      >RSS</a
    >
  </p>
</form>
