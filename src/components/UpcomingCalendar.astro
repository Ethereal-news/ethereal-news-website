---
import { type CollectionEntry, getCollection } from "astro:content";
import CalendarArrowCard from "@components/CalendarArrowCard.astro";
import Link from "@components/Link.astro";

const currentDate = new Date(); // Get today's date

const allUpcomingEvents = (await getCollection("calendar"))
  .filter((calendarItem) => !calendarItem.data.draft) // Filter out draft items
  .filter((calendarItem) => calendarItem.data.date >= currentDate) // Filter out past dates
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf()); // Sort by date

// Get next 3 events overall (sorted by date)
const next3Events = allUpcomingEvents.slice(0, 3);

// Get next 3 highlighted events (sorted by date)
const next3HighlightedEvents = allUpcomingEvents
  .filter((calendarItem) => calendarItem.data.highlight === true)
  .slice(0, 3);

// Combine and deduplicate by entry id
const eventMap = new Map();
next3Events.forEach((event) => eventMap.set(event.id, event));
next3HighlightedEvents.forEach((event) => eventMap.set(event.id, event));

// If we have fewer than 6 unique events, fill with more upcoming events
let calendar: CollectionEntry<"calendar">[] = Array.from(eventMap.values());
if (calendar.length < 6) {
  const selectedIds = new Set(calendar.map((e) => e.id));
  const additionalEvents = allUpcomingEvents
    .filter((event) => !selectedIds.has(event.id))
    .slice(0, 6 - calendar.length);
  calendar = [...calendar, ...additionalEvents];
}

// Sort by date
calendar.sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
---

<section class="animate space-y-6" data-pagefind-ignore>
  <div class="flex flex-wrap items-center justify-between gap-y-2">
    <h2 class="text-xl font-semibold text-black dark:text-white">
      Upcoming calendar
    </h2>
    <Link href="/calendar/"> See full calendar </Link>
  </div>
  <ul class="not-prose flex flex-col gap-4">
    {
      calendar.map((entry) => (
        <li>
          <CalendarArrowCard entry={entry} />
        </li>
      ))
    }
  </ul>
</section>
