---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<!--
  Three-state theme toggle: light → dark → system → light.
  The icon shown reflects the current preference, which the Head script
  exposes as the `data-theme` attribute on <html>. Click handling and
  aria-label updates live in Head.astro alongside the rest of the theme logic.
-->
<button
  aria-label="Theme: system"
  title="Theme: system"
  class={`theme-toggle text-black/50 transition-colors duration-300 ease-in-out hover:text-black dark:text-white/50 dark:hover:text-white ${className}`}
>
  <!-- Sun icon (light preference) -->
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="theme-icon-light hidden"
  >
    <circle cx="12" cy="12" r="5"></circle>
    <line x1="12" y1="1" x2="12" y2="3"></line>
    <line x1="12" y1="21" x2="12" y2="23"></line>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
    <line x1="1" y1="12" x2="3" y2="12"></line>
    <line x1="21" y1="12" x2="23" y2="12"></line>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
  </svg>
  <!-- Moon icon (dark preference) -->
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="theme-icon-dark hidden"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
  <!-- Monitor icon (system preference) -->
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="theme-icon-system hidden"
  >
    <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
    <line x1="8" y1="21" x2="16" y2="21"></line>
    <line x1="12" y1="17" x2="12" y2="21"></line>
  </svg>
</button>

<style is:global>
  html[data-theme="light"] .theme-icon-light,
  html[data-theme="dark"] .theme-icon-dark,
  html:not([data-theme="light"]):not([data-theme="dark"]) .theme-icon-system {
    display: block;
  }
</style>
